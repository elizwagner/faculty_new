p <- ggplot(policy_counts, aes(x = year)) +
geom_line(aes(y = total_policies), color = "black", size = 1) +  # Policies in black
geom_line(aes(y = scaled_arrests), color = "blue", size = 0.4) +  # Scaled violent crime rate in purple
facet_wrap(~ state, scales = "fixed") +  # Fixes scale across all facets
scale_x_continuous(breaks = seq(min(policy_counts$year), max(policy_counts$year), by = 5)) +  # X-axis every 5 years
scale_y_continuous(
breaks = seq(0, 6, by = 1),  # Fix y-axis ticks to 1, 2, 3, 4, 5, 6
limits = c(0, 6),  # Ensures every state facet has the same y-axis range
name = "Number of Policies",
sec.axis = sec_axis(~ . * max(policy_counts$robbery_vc_rate_per_100k, na.rm = TRUE) / max(policy_counts$total_policies, na.rm = TRUE),
name = "Robbery Incarcerations")
) +
labs(title = "Number of Policies and Robbery Incarcerations Rate per 100k",
subtitle = "Over Time by State",
x = "Year") +
theme_minimal() +
theme(
legend.position = "none",  # No legend
strip.text = element_text(size = 10, face = "bold"),  # Bold state labels
axis.text.x = element_text(angle = 45, hjust = 1)  # Tilt x-axis labels 45 degrees
)
ggsave("Policies_and_RobberyInc_by_State.png",
plot = p, width = 10, height = 8, dpi = 300)
p
# Ensure `vc_rate_per_100k` is included and grouped properly
policy_counts <- data4_summary %>%
left_join(data %>% select(state, year, murder_vc_rate_per_100k), by = c("state", "year"))
# Normalize `vc_rate_per_100k` for dual y-axis scaling
policy_counts <- policy_counts %>%
group_by(state) %>%
mutate(
max_policies = max(total_policies, na.rm = TRUE),
max_arrests = max(murder_vc_rate_per_100k, na.rm = TRUE),
scaled_arrests = ifelse(max_arrests > 0, murder_vc_rate_per_100k / max_arrests * max_policies, NA)  # Rescale violent crime rate
)
# Create the faceted plot with a fixed y-axis range
p <- ggplot(policy_counts, aes(x = year)) +
geom_line(aes(y = total_policies), color = "black", size = 1) +  # Policies in black
geom_line(aes(y = scaled_arrests), color = "seagreen", size = 0.4) +  # Scaled violent crime rate in purple
facet_wrap(~ state, scales = "fixed") +  # Fixes scale across all facets
scale_x_continuous(breaks = seq(min(policy_counts$year), max(policy_counts$year), by = 5)) +  # X-axis every 5 years
scale_y_continuous(
breaks = seq(0, 6, by = 1),  # Fix y-axis ticks to 1, 2, 3, 4, 5, 6
limits = c(0, 6),  # Ensures every state facet has the same y-axis range
name = "Number of Policies",
sec.axis = sec_axis(~ . * max(policy_counts$murder_vc_rate_per_100k, na.rm = TRUE) / max(policy_counts$total_policies, na.rm = TRUE),
name = "Murder Incarcerations")
) +
labs(title = "Number of Policies and Murder Incarcerations Rate per 100k",
subtitle = "Over Time by State",
x = "Year") +
theme_minimal() +
theme(
legend.position = "none",  # No legend
