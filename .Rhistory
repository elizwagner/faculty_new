library(magrittr)
library(augsynth)
# Load package
library(writexl)
library(stringr)
library(haven)
library(dplyr)
library(did2s)
library(did)
library(DRDID)
library(ggplot2)
library(Metrics) # for RMSE
library(patchwork) # for plots
library(cowplot)
library(reshape)
library(tibble)
library(tidyverse) # for data manipulation
library(zoo) # for time series analysis
library(tidyr)
library(forcats)
library(stringr)
library(hrbrthemes)
library(plotly)
library(magrittr)
library(lme4)
library(remotes)
prison_admissions_data_VC <- read_csv("prison_admissions_data_VC.csv")
data <- prison_admissions_data_VC
load("~/38492-0001-Data.rda")
data <- da38492.0001
data <- data %>%
filter(ADMITYR >= 1989, STATE != "(11) District of Columbia")
data <- data %>%
select(STATE, ADMITYR, ABT_INMATE_ID, SEX, ADMTYPE, OFFGENERAL, SENTLGTH, OFFDETAIL, RACE, AGEADMIT, TIMESRVD)
# Filter for violent offenses and calculate total admissions per state and year
weapons_admissions <- data %>%
filter(OFFGENERAL == "(4) Public order") %>%
group_by(STATE, ADMITYR) %>%
summarise(total_admissions_puborder = n(), .groups = "drop")  # Count records per state and year
# Remove numeric prefixes from the STATE variable
weapons_admissions <- weapons_admissions %>%
mutate(STATE = gsub("^\\(\\d+\\)\\s", "", STATE))
weapons_admissions <- weapons_admissions %>%
rename(state = STATE) %>%
rename(year = ADMITYR)
# Filter the dataset to include only the specified OFFDETAIL values
data_filtered <- data %>%
filter(OFFDETAIL %in% c("(01) Murder (including non-negligent manslaughter)",
"(04) Robbery",
"(05) Aggravated or simple assault"))
# Remove numeric prefixes from the STATE variable
data_filtered <- data_filtered %>%
mutate(STATE = gsub("^\\(\\d+\\)\\s", "", STATE))
# Filter for violent offenses and calculate total admissions per state and year
violent_admissions_robbery <- data_filtered %>%
filter(OFFDETAIL == "(04) Robbery") %>%  # Filter for violent offenses
group_by(STATE, ADMITYR) %>%             # Group by state and admission year
summarise(robbery_total_admissions_vc = n(), .groups = "drop")  # Count records per state and year
violent_admissions_aggassault <- data_filtered %>%
filter(OFFDETAIL == "(05) Aggravated or simple assault") %>%  # Filter for violent offenses
group_by(STATE, ADMITYR) %>%             # Group by state and admission year
summarise(aggassault_total_admissions_vc = n(), .groups = "drop")  # Count records per state and year
violent_admissions_murder <- data_filtered %>%
filter(OFFDETAIL == "(01) Murder (including non-negligent manslaughter)") %>%  # Filter for violent offenses
group_by(STATE, ADMITYR) %>%             # Group by state and admission year
summarise(murder_total_admissions_vc = n(), .groups = "drop")  # Count records per state and year
# Merge the datasets using full_join
violent_admissions <- violent_admissions_robbery %>%
full_join(violent_admissions_aggassault, by = c("STATE", "ADMITYR")) %>%
full_join(violent_admissions_murder, by = c("STATE", "ADMITYR"))
violent_admissions <- violent_admissions %>%
rename(state = STATE) %>%
rename(year = ADMITYR)
# Count occurrences of each combination of ABT_INMATE_ID and ADMITYR
combo_counts <- data_filtered %>%
count(ABT_INMATE_ID, ADMITYR)
# Filter for combinations that appear more than once
repeated_combos <- combo_counts %>%
filter(n > 2)
# Count the number of unique repeated combinations
nrow(repeated_combos)
da38492.0001%>%
filter(ABT_INMATE_ID == "A012021000000001442", ADMITYR == 2007)
# Count occurrences of each unique combination across all columns
combo_counts <- data_filtered %>%
count(across(everything()))
# Count the number of unique combinations
num_unique_combos <- nrow(combo_counts)
# View combinations that appear more than once
repeated_combos <- combo_counts %>%
filter(n > 1)
# Count how many unique combinations appear more than once
num_repeated_combos <- nrow(repeated_combos)
# Print results
cat("Total unique combinations:", num_unique_combos, "\n")
cat("Combinations appearing more than once:", num_repeated_combos, "\n")
violent_admissions %>%
summarise(across(everything(), ~ sum(is.na(.)), .names = "na_count_{col}"))
# Replace NA with 0
violent_admissions <- violent_admissions %>%
mutate(across(ends_with("_vc"), ~ replace_na(., 0)))
weapons_arrests_joyce <- read_dta("WeaponsArrestsJoyce.dta")
weapons_arrests_joyce <- weapons_arrests_joyce %>%
select(year, state, state_abb, fips, unemployment_rate, poverty_rate, beer_ip, pct_msa_ucr_hybrid, rpcpi, l_policeemployeerate0, totalpop, blackmalepop, whitepop, malepop, femalepop)
combined_data <- violent_admissions %>%
inner_join(weapons_arrests_joyce, by = c("year", "state")) # Use left_join, full_join, or right_join as needed
