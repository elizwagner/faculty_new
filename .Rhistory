# Add Time, Intervention, and Post.Intervention.Time variables
data4 <- data4 %>%
mutate(Time = year - min(year) + 1,                              # Sequential time periods
Intervention = ifelse(year >= 2009, 1, 0),               # Binary intervention indicator
Post.Intervention.Time = ifelse(Intervention == 1, year - 2009 + 1, 0))  # Time since intervention
library(nlme)
# Define the ITS model
its_model <- gls(vc_rate_per_100k_log_1 ~ Time + Intervention + Post.Intervention.Time,
data = data4,
method = "ML")
# Model summary
summary(its_model)
# Step 1: Create variables for ITS
data4 <- data4 %>%
mutate(
Intervention = ifelse(year >= 2009, 1, 0),  # Intervention year is 2009
Post.Intervention.Time = ifelse(Intervention == 1, year - 2009 + 1, 0),
Time = year - min(year) + 1
)
# Step 2: Fit the ITS Model
library(nlme)
# Basic GLS model without autocorrelation adjustment
model_its <- gls(
vc_rate_per_100k_log_1 ~ Time + Intervention + Post.Intervention.Time,
data = data4,
method = "ML"
)
# Summary of the model
summary(model_its)
# Step 3: Add predicted values and standard errors to the dataset
library(AICcmodavg)
data4 <- data4 %>%
mutate(
predictions = predictSE.gls(model_its, data4, se.fit = TRUE)$fit,
se = predictSE.gls(model_its, data4, se.fit = TRUE)$se
)
# Step 4: Visualize ITS Results
library(ggplot2)
ggplot(data4, aes(x = year, y = vc_rate_per_100k_log_1)) +
geom_ribbon(
aes(
ymin = predictions - 1.96 * se,
ymax = predictions + 1.96 * se
),
fill = "lightgreen", alpha = 0.5
) +
geom_line(aes(y = predictions), color = "black", linetype = "solid") +
geom_point(alpha = 0.5) +
theme_minimal() +
labs(
title = "Interrupted Time Series Analysis: Violent Crime Rates in Missouri",
x = "Year",
y = "Violent Crime Rate per 100k",
caption = "Solid line: Model predictions | Green ribbon: 95% CI"
)
# Group by state and year, calculate mean rates if needed
data_grouped <- data4 %>%
group_by(state, year) %>%
summarize(vc_rate_per_100k = mean(vc_rate_per_100k, na.rm = TRUE), .groups = "drop")
ggplot(data_grouped, aes(x = year, y = vc_rate_per_100k, group = state)) +
geom_line(color = "blue") +
geom_point(alpha = 0.5) +
geom_vline(xintercept = 2009, linetype = "dashed", color = "red") +
labs(
title = "Time Series: Violent Crime Rates by State",
x = "Year",
y = "Violent Crime Rate per 100k",
caption = "Red dashed line indicates the intervention year"
) +
facet_wrap(~state, scales = "free_y") +  # Separate panels for each state
theme_minimal()
ggplot(data_grouped, aes(x = year, y = vc_rate_per_100k, group = state)) +
geom_line(color = "blue", alpha = 0.5) +
geom_smooth(method = "loess", color = "green") +  # Add smoothed trend
geom_vline(xintercept = 2009, linetype = "dashed", color = "red") +
labs(
title = "Smoothed Time Series: Violent Crime Rates by State",
x = "Year",
y = "Violent Crime Rate per 100k",
caption = "Red dashed line indicates the intervention year"
) +
facet_wrap(~state, scales = "free_y") +
theme_minimal()
